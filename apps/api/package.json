{
  "name": "@habit-tracker/api",
  "version": "1.0.0",
  "license": "0BSD",
  "private": true,
  "type": "module",
  "scripts": {
    "docker:up": "docker compose up --build",
    "docker:start": "docker compose start",
    "docker:stop": "docker compose stop",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v",
    "db:logs": "docker compose logs -f db",
    "db:psql": "docker compose exec db psql -U habits_user -d habits",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.build.json",
    "start": "node --enable-source-maps ./dist/server.js",
    "eslint": "eslint \"src/**/*.ts\"",
    "eslint:fix": "eslint --fix \"src/**/*.ts\"",
    "oxlint": "oxlint --type-aware",
    "lint": "npm-run-all --parallel --continue-on-error oxlint eslint",
    "lint:fix": "oxlint --type-aware --fix && eslint --fix \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-oxlint": "^1.86.0",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.4",
    "env-schema": "^8.0.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.23.1",
    "typebox": "^1.3.34"
  }
}
